if __name__ == "__main__":
    import numpy as np
    import pandas as pd

    SEEDS = list(range(1, 11))
    EPSILON = 0.1
    TERMINAL_ACTIVITY = "/hbw/store"
    horizon = float(SIMULATION_TIME)

    def _metrics(df):
        wait = df["time:timestamp"] - df["queue_enter"]
        per_res_wait = wait.groupby(df["resource"]).mean()
        sys_wait = float(wait.mean())
        store = df[df["activity"] == TERMINAL_ACTIVITY]
        completed_ids = list(store["case_id"].unique())
        flows = []
        for cid in completed_ids:
            sub = df[df["case_id"] == cid]
            flows.append(float(sub["operation_end_time"].max() - sub["case_arrival"].iloc[0]))
        flow = float(np.mean(flows)) if flows else float("nan")
        busy = (df["operation_end_time"] - df["time:timestamp"]).groupby(df["resource"]).sum()
        util = (busy / horizon).sort_values(ascending=False)
        return {"per_res_wait": per_res_wait, "sys_wait": sys_wait, "flow": flow,
                "n_completed": len(completed_ids), "util": util}

    def _run_all():
        return [run_single_replication(s) for s in SEEDS]

    base = _metrics(pd.concat(_run_all()))
    aug_res = base["util"].index[0]
    orig_cap = RESOURCE_CAPACITIES[aug_res]
    RESOURCE_CAPACITIES[aug_res] = orig_cap + 1
    try:
        aug = _metrics(pd.concat(_run_all()))
    finally:
        RESOURCE_CAPACITIES[aug_res] = orig_cap

    w_base = float(base["per_res_wait"][aug_res])
    w_aug = float(aug["per_res_wait"][aug_res])
    mr1a = w_aug < w_base
    mr1b = aug["flow"] <= base["flow"] + EPSILON
    strict = aug["sys_wait"] <= base["sys_wait"]
    overall = mr1a and mr1b

    print("=== Refined MR1 oracle (10 replications, common random numbers) ===")
